QWidget {
    color: $text; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
}
QMainWindow, QScrollArea, QWidget#canvas { background: $background; }
QScrollArea { border: none; }
QLabel { background: transparent; }
QFrame#sidebar { background: $sidebar; border-right: 1px solid $border; }
QFrame#card, QFrame#statusCard { background: $surface; border: 1px solid $border; border-radius: ${radius}px; }
QFrame#urlCard { background: $surface; border: 1px solid $border; border-radius: ${radius}px; }
QFrame#urlCard[state="error"] { border-color: $error; }
QLabel#eyebrow { color: $hover; font-size: 11px; font-weight: 700; }
QLabel#heading { font-size: 28px; font-weight: 700; }
QLabel#sectionHeading { font-size: 18px; font-weight: 600; }
QLabel#cardTitle { font-size: 16px; font-weight: 600; }
QLabel#subtitle, QLabel#footer, QLabel#technical { color: $muted; }
QLabel#footer { font-size: 11px; }
QLabel#summary { font-weight: 600; }
QLabel#badge { background: $selected; color: $focus; border-radius: 8px; padding: 4px 8px; font-size: 11px; }
QLabel[state="available"], QLabel[state="success"] { color: $success; }
QLabel[state="missing"], QLabel[state="unsupported"] { color: $warning; }
QLabel[state="error"], QLabel#subtitle[state="error"] { color: $error; }
QLabel#subtitle[state="success"] { color: $success; }
QLabel#thumbnail { background: $background; color: $muted; border-radius: 12px; }
QPushButton, QToolButton {
    background: $raised; border: 1px solid $border; border-radius: 8px;
    padding: 10px 16px; font-weight: 600;
}
QPushButton:hover, QToolButton:hover { background: $selected; border-color: $hover; }
QPushButton:pressed, QToolButton:pressed { background: $selected; }
QPushButton:focus, QToolButton:focus { border-color: $focus; }
QPushButton:disabled, QToolButton:disabled { background: $raised; color: $muted; border-color: $border; }
QPushButton#primaryButton { background: $accent; border-color: $accent; }
QPushButton#primaryButton:hover { background: $primary_hover; border-color: $hover; }
QPushButton#primaryButton:focus { border: 2px solid $focus; padding: 9px 15px; }
QPushButton#primaryButton:disabled { background: $selected; color: $muted; border-color: $border; }
QPushButton#navButton { background: transparent; border: 1px solid transparent; text-align: left; padding: 12px; color: $muted; }
QPushButton#navButton:hover { background: $raised; color: $text; }
QPushButton#navButton:checked { background: $selected; color: $text; border-color: $border; }
QPushButton#navButton:focus { border-color: $focus; }
QFrame#segmented { background: $sidebar; border: 1px solid $border; border-radius: 10px; }
QPushButton#segment { background: transparent; border: 1px solid transparent; padding: 8px 16px; color: $muted; }
QPushButton#segment:checked { background: $raised; color: $text; border-color: $border; }
QPushButton#segment:hover { color: $text; }
QPushButton#segment:focus { border-color: $focus; }
QPushButton#qualityCard { background: $surface; border: 1px solid $border; border-radius: 12px; padding: 0; text-align: left; }
QPushButton#qualityCard:hover { background: $raised; border-color: $hover; }
QPushButton#qualityCard:checked { background: $selected; border-color: $hover; }
QPushButton#qualityCard:focus { border: 2px solid $focus; }
QPushButton#qualityCard:disabled { color: $muted; background: $sidebar; }
QPushButton#qualityCard[available="false"] QLabel { color: $muted; }
QProgressBar { border: none; background: $raised; border-radius: 2px; max-height: 4px; }
QProgressBar::chunk { background: $hover; border-radius: 2px; }
QStatusBar { background: $background; color: $muted; border-top: 1px solid $border; font-size: 11px; }
QToolTip { background: $raised; color: $text; border: 1px solid $border; padding: 6px; }
QLineEdit { background: $background; border: 1px solid $border; border-radius: 8px; padding: 12px; selection-background-color: $accent; }
QLineEdit:focus { border-color: $focus; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: $border; min-height: 32px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: $muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
